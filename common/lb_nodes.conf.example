# 存储节点画像配置 —— 供改进的负载均衡算法使用
#
# 复制到 /etc/fdfs/lb_nodes.conf（或用环境变量 LB_NODE_PROFILE 指定其它路径）。
# 该文件缺失时算法会使用默认画像（perf=1.0、并发上限=64），此时等价于
# "按剩余空间比例 + 负载"选盘，不会报错。
#
# 格式： <key> = <磁盘性能系数>:<并发上限>
#   key              可以是组名（参与组级决策），也可以是节点 IP（参与组内决策）
#   磁盘性能系数      实测相对写带宽，SSD 取 1.0、SAS 取 0.75、HDD 取 0.55
#   并发上限         该组/节点允许的在途写任务数，超过高水位后会被算法跳过
#
# 性能系数怎么来的：在同一批机器上用同样的文件做 dt 或 fio 顺序写，
# 以最快的节点为基准 1.0，其余按带宽比例折算。
#
# 下面给出的是一个示例拓扑（容量与性能倒挂，用于说明算法为什么要归一化），
# 部署时请替换为自己的真实组名与 IP。

# ---- 组级（推荐至少配置这一层）----
group1 = 1.00:96     # SSD 组：写带宽最好，但容量最小
group2 = 0.55:96     # HDD 组：容量最大，写带宽一般
group3 = 0.55:48     # HDD 单节点组

# ---- 节点级（可选，用于组内更精细的区分）----
# 10.0.0.11 = 1.00:48
# 10.0.0.12 = 1.00:48
# 10.0.0.21 = 0.55:48
# 10.0.0.22 = 0.55:48
