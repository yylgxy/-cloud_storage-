# 云存储项目 — 环境变量配置
# 复制此文件为 .env 并填入实际值

# MySQL 数据库密码（必填）
DB_PASSWORD="你的数据库密码"

# 可选：Redis 密码（如果设置了 Redis 认证）
# REDIS_PASSWORD=""

# 可选：开启 FastDFS 存储负载均衡（由本地改进算法选组）
# 不设置或设为 0 时，走 FastDFS 原生选盘逻辑，便于灰度与快速回退
LB_ENABLE="1"

# 可选：存储节点画像配置路径（磁盘性能系数 / 并发上限）
# 默认 /etc/fdfs/lb_nodes.conf，该文件不存在时使用默认画像
LB_NODE_PROFILE="/etc/fdfs/lb_nodes.conf"

# 可选：启动脚本打印访问地址时使用
# SERVER_IP=""
# CLOUD_STORAGE_BIN=""
